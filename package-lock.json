@tailwind base;
@tailwind components;
@tailwind utilities;

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', system-ui, sans-serif;
  background-color: #07111f;
  color: #f8f5ef;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #0d1b2a;
}

::-webkit-scrollbar-thumb {
  background: rgba(214, 181, 109, 0.2);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(214, 181, 109, 0.35);
}

/* Screen transition styles */
.screen-enter {
  opacity: 0;
  transform: translateY(20px);
}

.screen-enter-active {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

/* Luxury button - restrained gold */
.luxury-button {
  @apply relative overflow-hidden rounded-full px-8 py-4 font-sans font-medium tracking-wide;
  background: transparent;
  border: 1px solid rgba(212, 175, 55, 0.35);
  color: #d6b56d;
  transition: all 450ms cubic-bezier(0.22, 1, 0.36, 1);
}

.luxury-button:hover {
  background: rgba(212, 175, 55, 0.08);
  border-color: rgba(212, 175, 55, 0.5);
  transform: translateY(-2px);
}

.luxury-button:active {
  transform: translateY(0);
}

/* Brand card styles - no glow */
.brand-card {
  @apply relative overflow-hidden rounded-lg cursor-pointer;
  background: linear-gradient(145deg, rgba(13, 27, 42, 0.7) 0%, rgba(7, 17, 31, 0.85) 100%);
  border: 1px solid rgba(212, 175, 55, 0.15);
  transition: all 450ms cubic-bezier(0.22, 1, 0.36, 1);
}

.brand-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(212, 175, 55, 0.03);
  opacity: 0;
  transition: opacity 450ms cubic-bezier(0.22, 1, 0.36, 1);
}

.brand-card:hover::before {
  opacity: 1;
}

.brand-card:hover {
  transform: translateY(-4px);
  border-color: rgba(212, 175, 55, 0.5);
  background: linear-gradient(145deg, rgba(13, 27, 42, 0.75) 0%, rgba(7, 17, 31, 0.9) 100%);
}

/* Gradient overlays */
.gradient-overlay {
  background: linear-gradient(180deg,
    rgba(7, 17, 31, 0.4) 0%,
    rgba(7, 17, 31, 0.7) 50%,
    rgba(7, 17, 31, 0.95) 100%
  );
}

/* Accent underline for headlines */
.headline-underline {
  position: relative;
  display: inline-block;
}

.headline-underline::after {
  content: '';
  position: absolute;
  bottom: -0.25em;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 1px;
  background: rgba(212, 175, 55, 0.4);
}

/* Image card frame - consistent treatment */
.image-card {
  @apply relative overflow-hidden rounded-2xl;
  border: 1px solid rgba(212, 175, 55, 0.25);
  box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.5);
}

/* Textured background with radial gradient and noise overlay */
.textured-bg {
  position: relative;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(40, 76, 120, 0.25) 0%, transparent 50%),
              radial-gradient(ellipse 60% 40% at 50% 100%, transparent 0%, #050a12 80%),
              linear-gradient(180deg, #07111f 0%, #0d1b2a 50%, #07111f 100%);
}

.textured-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.04;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 200px 200px;
}

/* Animated background gradient */
.animated-gradient {
  position: relative;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(40, 76, 120, 0.25) 0%, transparent 50%),
              radial-gradient(ellipse 60% 40% at 50% 100%, transparent 0%, #050a12 80%),
              linear-gradient(180deg, #07111f 0%, #0d1b2a 50%, #07111f 100%);
}

.animated-gradient::before {
  content: '';
  position: absolute;
  inset: 0;
  opacity: 0.04;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 200px 200px;
}

/* Delay utilities */
.delay-100 { animation-delay: 0.1s; }
.delay-200 { animation-delay: 0.2s; }
.delay-300 { animation-delay: 0.3s; }
.delay-400 { animation-delay: 0.4s; }
.delay-500 { animation-delay: 0.5s; }
.delay-600 { animation-delay: 0.6s; }

/* Brand card entrance animation */
@keyframes brandCardIn {
  0% {
    opacity: 0;
    transform: translateY(12px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
